DATABASE_URL=sqlite:///./zoom.db
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET=generate-a-long-random-string-at-least-32-bytes
DEFAULT_USER_EMAIL=kartikchopra@demo.dev
# Set to true when served over HTTPS.
COOKIE_SECURE=false
EMPTY_ROOM_GRACE_SECONDS=30
# ICE servers for WebRTC (JSON lists). TURN is needed for peers on strict networks.
STUN_URLS=["stun:stun.l.google.com:19302"]
TURN_URLS=[]
TURN_USERNAME=
TURN_CREDENTIAL=
